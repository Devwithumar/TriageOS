# LLM provider: stub | groq | openai | anthropic
LLM_PROVIDER=stub

# Groq (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Speech-to-text: stub | deepgram
STT_PROVIDER=stub
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Service wiring
CONVERSATION_SERVICE_URL=http://127.0.0.1:8001
REDIS_URL=redis://localhost:6379/0

# Provider directory: OpenStreetMap geocoding + Overpass search + filtered Nominatim fallback
PROVIDER_DIRECTORY_PROVIDER=osm
OSM_USER_AGENT=TriageOS/0.1 (replace-with-contact)
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
# PROVIDER_DIRECTORY_CACHE_TTL=600
# PROVIDER_DIRECTORY_RADIUS_METERS=5000
# PROVIDER_DIRECTORY_SEARCH_TIMEOUT=8
# PROVIDER_DIRECTORY_OPERATION_TIMEOUT=12
# PROVIDER_DIRECTORY_GEOCODE_TIMEOUT=5
# PROVIDER_DIRECTORY_MAX_ATTEMPTS=2
# PROVIDER_DIRECTORY_RETRY_BACKOFF=0.25
# PROVIDER_DIRECTORY_CIRCUIT_FAILURE_THRESHOLD=3
# PROVIDER_DIRECTORY_CIRCUIT_OPEN_SECONDS=30

# Scheduling adapter: unconfigured | mock | google_calendar
SCHEDULING_PROVIDER=unconfigured
# GOOGLE_CALENDAR_ACCESS_TOKEN=
# GOOGLE_CALENDAR_ACCESS_TOKEN_EXPIRES_IN=3600
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_CALENDAR_TOKEN_SKEW_SECONDS=60
# GOOGLE_CALENDAR_ID=
# GOOGLE_CALENDAR_BASE_URL=https://www.googleapis.com/calendar/v3
# GOOGLE_CALENDAR_EVENT_SUMMARY=TriageOS appointment request
# SCHEDULING_TIMEZONE=UTC
# SCHEDULING_WINDOW_DAYS=14
# SCHEDULING_SLOT_MINUTES=30
# SCHEDULING_MAX_SLOTS=10
# SCHEDULING_WORKDAY_START=09:00
# SCHEDULING_WORKDAY_END=17:00
# SCHEDULING_REQUEST_TIMEOUT=8
